# Токен от @BotFather — единственное, что обязательно заполнить.
BOT_TOKEN=123456:ABC-your-token

# Имя бота (одно для всех языков интерфейса) и @username без «@».
BOT_NAME=Твой личный астролог | Таро и гороскоп
BOT_USERNAME=TaroAstrologiaGoroskopBot

# polling — для запуска на своём компьютере; webhook — для сервера с HTTPS.
RUN_MODE=polling
WEBHOOK_BASE_URL=https://bot.example.com
WEBHOOK_PATH=/webhook
WEBHOOK_SECRET=change-me-random-string
WEB_PORT=8080

# База и Redis. В docker compose адреса подставляются автоматически,
# здесь достаточно задать пароль.
POSTGRES_USER=astro
POSTGRES_PASSWORD=change-me
POSTGRES_DB=astro

DEFAULT_LANGUAGE=ru
DEFAULT_TIMEZONE=Europe/Moscow
DEFAULT_DAILY_CARD_TIME=09:00

# Ключ Anthropic API (console.anthropic.com). Без ключа трактовки пишутся из готовых текстов.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-5-5
# Дневной бюджет на ИИ в долларах.
LLM_DAILY_BUDGET_USD=5

# Бесплатных раскладов на вопрос в день и мягкий лимит для подписчиков.
FREE_QUESTIONS_PER_DAY=1
PREMIUM_READINGS_PER_DAY=30
# true — открыть всем платные разделы (для демо, пока нет оплаты).
PREMIUM_FOR_ALL=false

# Telegram ID администраторов через запятую.
ADMIN_IDS=
LOG_LEVEL=INFO
